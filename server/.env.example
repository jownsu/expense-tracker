# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres (Neon) — use the direct/unpooled host (no -pooler) so migrations work
DATABASE_URL=

# Better Auth — generate BETTER_AUTH_SECRET with: openssl rand -base64 32
# BETTER_AUTH_URL is this API's base URL. Google keys from Google Cloud Console.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
